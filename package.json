{
  "name": "email-mcp",
  "version": "0.1.0",
  "description": "Lokální MCP server pro IMAP/SMTP e-mail (připraveno pro Webglobe): čtení, filtrování a příprava draftů přímo z Claude.",
  "type": "module",
  "bin": {
    "email-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev:http": "tsx watch src/http.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "npm run build && npx -y @anthropic-ai/mcpb pack . email-mcp.mcpb"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "imap",
    "smtp",
    "webglobe",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "imapflow": "^1.3.5",
    "jose": "^6.1.3",
    "mailparser": "^3.9.9",
    "nodemailer": "^8.0.10",
    "pg": "^8.13.0",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
