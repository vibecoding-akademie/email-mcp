# ── Přihlášení k e-mailovému účtu ────────────────────────────────────────────
# Zkopíruj tento soubor jako `.env.local` a vyplň heslo.
#   PowerShell:  Copy-Item .env.example .env.local
# .env.local se NIKDY necommituje (je v .gitignore).

# Celá e-mailová adresa = zároveň přihlašovací jméno
EMAIL_USER=vase-adresa@vase-domena.cz
EMAIL_PASSWORD=

# Volitelné jméno odesílatele (zobrazí se příjemci místo holé adresy)
EMAIL_FROM_NAME=

# ── Servery Webglobe (výchozí hodnoty, obvykle není třeba měnit) ──────────────
# Zdroj: https://www.webglobe.cz/poradna/jake-parametry-pro-nastaveni-emailoveho-klienta-pouzit
IMAP_HOST=mail.webglobe.cz
IMAP_PORT=993
IMAP_SECURE=true

SMTP_HOST=mail.webglobe.cz
SMTP_PORT=465
SMTP_SECURE=true

# Pokud používáš Office Mail (IceWarp), odkomentuj a nastav:
# IMAP_HOST=webglobe1.onice.io
# SMTP_HOST=webglobe1.onice.io
# SMTP_PORT=587
# SMTP_SECURE=false   # 587 = STARTTLS

# ── Pokročilé (volitelné) ────────────────────────────────────────────────────
# Server sám detekuje speciální složky přes IMAP. Vyplň jen když detekce selže.
# DRAFTS_FOLDER=Drafts
# SENT_FOLDER=Sent

# Pro testování proti serveru se samopodepsaným certifikátem dej false (jinak nech true).
TLS_REJECT_UNAUTHORIZED=true

# ── ONLINE režim (claude.ai / mobil) — jen pro hostovanou variantu (Railway) ──
# Lokální (.mcpb / stdio) verze tyto NEpotřebuje.
#
# Veřejná HTTPS adresa serveru. Na Railway se odvodí automaticky z
# RAILWAY_PUBLIC_DOMAIN, takže ji obvykle nemusíš vyplňovat. Vyplň jen u vlastní domény.
# PUBLIC_URL=https://email-mcp.up.railway.app
#
# Heslo, kterým se přihlásíš při napojování connectoru v claude.ai. Zvol SILNÉ.
OWNER_PASSWORD=
#
# Tajný klíč pro podepisování přihlašovacích tokenů. Vygeneruj náhodný, např.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
#
# Port (Railway si ho nastaví sám; lokálně výchozí 3000).
# PORT=3000
